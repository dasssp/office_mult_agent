APP_ENV=development
APP_NAME=office-multi-agent
LOG_LEVEL=INFO
MAX_REQUEST_BODY_BYTES=2097152
LANGGRAPH_STRICT_MSGPACK=true
# 渐进切换：legacy 保留原固定路由；deep_agent 启用主 Agent + 领域子 Agent。
ASSISTANT_RUNTIME=legacy
# Deep Agent 模式必须配置 LangChain 模型标识及对应供应商密钥。
# AGENT_MODEL=openai:gpt-5.4
# OPENAI_API_KEY=replace-with-a-secret
# 可替换为 Anthropic 或 Google，并注入对应供应商密钥。
AGENT_RECURSION_LIMIT=48
AGENT_TIMEOUT_SECONDS=180
# Independent Java RAG MCP adapter (streamable HTTP endpoint).
# KNOWLEDGE_MCP_URL=http://knowledge-mcp-adapter:8001/mcp
# KNOWLEDGE_MCP_SERVICE_TOKEN=replace-with-a-secret
# MCP adapter variables:
# JAVA_RAG_BASE_URL=https://java-rag.internal.example
# MCP_SERVICE_TOKEN=replace-with-the-same-secret
APP_PORT=8000
POSTGRES_DB=office_multi_agent
POSTGRES_USER=office_app
# Set a strong secret before any shared or production deployment.
POSTGRES_PASSWORD=change-me-before-production
# PostgreSQL production example; migrations must be applied before starting the API.
# DATABASE_URL=postgresql+asyncpg://office_app:change-me@localhost:5432/office_multi_agent
# Alembic's synchronous migration URL is configured in alembic.ini.
